filters:
  and:
    - file.hasTag("projekt")
    - file.ext == "md"
formulas:
  marke: if(file.path.contains("Fairbeamtet"), "fairbeamtet.de", "—")
  zuletzt: file.mtime.format("YYYY-MM-DD")
properties:
  formula.marke:
    displayName: Marke
  formula.zuletzt:
    displayName: Zuletzt geändert
  status:
    displayName: Status
views:
  - type: table
    name: Aktiv
    filters:
      and:
        - status == "aktiv"
    groupBy:
      property: formula.marke
      direction: ASC
    order:
      - file.name
      - formula.marke
      - formula.zuletzt
  - type: table
    name: Alle
    order:
      - file.name
      - status
      - formula.marke
      - formula.zuletzt
