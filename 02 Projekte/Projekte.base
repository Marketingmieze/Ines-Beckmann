filters:
  and:
    - file.hasTag("projekt")
    - 'file.ext == "md"'

formulas:
  marke: 'if(file.path.contains("Fairbeamtet"), "fairbeamtet.de", if(file.path.contains("Marketingmieze"), "marketingmieze.com", "—"))'
  zuletzt: 'file.mtime.format("YYYY-MM-DD")'

properties:
  formula.marke:
    displayName: "Marke"
  formula.zuletzt:
    displayName: "Zuletzt geändert"
  status:
    displayName: "Status"

views:
  - type: table
    name: "Aktiv"
    filters:
      and:
        - 'status == "aktiv"'
    order:
      - file.name
      - formula.marke
      - formula.zuletzt
    groupBy:
      property: formula.marke
      direction: ASC

  - type: table
    name: "Alle"
    order:
      - file.name
      - status
      - formula.marke
      - formula.zuletzt
