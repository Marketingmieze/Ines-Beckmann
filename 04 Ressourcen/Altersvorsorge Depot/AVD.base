filters:
  and:
    - file.inFolder("04 Ressourcen/Altersvorsorge Depot/Fakten")
    - file.hasTag("avd")
    - geprueft
formulas:
  zahl: 'if(wert, wert + if(einheit, " " + einheit, ""), "")'
  ampel: 'if(urteil == "WIDERLEGT", "🔴 widerlegt", if(urteil == "UNBELEGT", "⚫ unbelegt", if(urteil == "TEILWEISE", "🟡 verkürzt", if(urteil == "KORRIGIERT" || urteil == "KORREKTUR", "🟠 korrigiert", if(urteil == "NEU", "🔵 ergänzt", "🟢 bestätigt")))))'
  nur_beamte: 'if(beamte, "👮 Beamte", "")'
properties:
  file.name:
    displayName: Fakt
  kategorie:
    displayName: Kategorie
  urteil:
    displayName: Urteil
  fundstelle:
    displayName: Fundstelle
  wert:
    displayName: Wert
  einheit:
    displayName: Einheit
  bezug:
    displayName: Bezug
  gilt_ab:
    displayName: Gilt ab
  variante:
    displayName: Variante
  beamte:
    displayName: Beamten-relevant
  geprueft:
    displayName: Geprüft am
  quelle:
    displayName: Videoquelle
  formula.zahl:
    displayName: Zahl
  formula.ampel:
    displayName: Status
  formula.nur_beamte:
    displayName: ""
views:
  - type: table
    name: Alle Fakten
    groupBy:
      property: kategorie
      direction: ASC
    order:
      - file.name
      - formula.ampel
      - formula.zahl
      - fundstelle
      - gilt_ab
      - formula.nur_beamte

  - type: table
    name: Besonderheiten für Beamte
    filters:
      and:
        - beamte == true
    groupBy:
      property: kategorie
      direction: ASC
    order:
      - file.name
      - formula.ampel
      - formula.zahl
      - fundstelle
      - gilt_ab

  - type: table
    name: Nicht verwenden
    filters:
      or:
        - urteil == "WIDERLEGT"
        - urteil == "UNBELEGT"
    order:
      - file.name
      - formula.ampel
      - kategorie
      - fundstelle

  - type: table
    name: Korrekturen am Video
    filters:
      or:
        - urteil == "WIDERLEGT"
        - urteil == "TEILWEISE"
        - urteil == "KORRIGIERT"
        - urteil == "KORREKTUR"
    groupBy:
      property: urteil
      direction: ASC
    order:
      - file.name
      - kategorie
      - fundstelle
      - formula.zahl

  - type: table
    name: Belastbar für Content
    filters:
      or:
        - urteil == "BESTÄTIGT"
        - urteil == "NEU"
    groupBy:
      property: kategorie
      direction: ASC
    order:
      - file.name
      - formula.zahl
      - fundstelle
      - gilt_ab

  - type: table
    name: Nur Zahlen
    filters:
      and:
        - wert
    order:
      - file.name
      - wert
      - einheit
      - bezug
      - kategorie
      - formula.ampel

  - type: table
    name: Förderung
    filters:
      and:
        - kategorie == "Förderung"
    order:
      - file.name
      - formula.ampel
      - formula.zahl
      - bezug
      - fundstelle

  - type: table
    name: Fristen und Stichtage
    filters:
      and:
        - gilt_ab
    order:
      - gilt_ab
      - file.name
      - kategorie
      - formula.ampel

  - type: table
    name: Produkt und Rentenphase
    filters:
      or:
        - kategorie == "Produktvarianten"
        - kategorie == "Rentenphase"
    groupBy:
      property: variante
      direction: ASC
    order:
      - file.name
      - formula.ampel
      - formula.zahl
      - fundstelle

  - type: table
    name: Für Vermittler
    filters:
      or:
        - kategorie == "Vergütung"
        - kategorie == "Riester-Wechsel"
        - kategorie == "Anbieterwechsel"
        - kategorie == "Tools und Praxis"
    groupBy:
      property: kategorie
      direction: ASC
    order:
      - file.name
      - formula.ampel
      - formula.zahl
      - fundstelle

  - type: cards
    name: Karten
    groupBy:
      property: kategorie
      direction: ASC
    order:
      - file.name
      - formula.ampel
      - formula.zahl
